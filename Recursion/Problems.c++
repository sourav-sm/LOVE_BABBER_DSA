#include<bits/stdc++.h>
using namespace std;

// . Reverse String [Using Recursion]
class Solution {
public:
     void solve(vector<char>& s,int st,int lt){
        if(st>=lt)return ;
        swap(s[st],s[lt]);
        return solve(s,st+1,lt-1);

     }
     vector<char> reverseString(vector<char>& s) {
        solve(s,0,s.size()-1);
        return s;
    }
};
